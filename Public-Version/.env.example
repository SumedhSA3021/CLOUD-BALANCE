# CloudBalance 12-Factor Environment Configuration Example
# Copy to .env and customize for your deployment. Never commit real .env files!
# Every Controller Settings field supports both names listed on its "# Aliases:" line.

# --- 1. Controller Identity & Required Secrets ---
# Variable: CB_APP_NAME | Alias: APP_NAME
CB_APP_NAME="CloudBalance Controller"
# Variable: CB_ENV | Alias: ENVIRONMENT
CB_ENV="development"

# Required Cluster Secrets (Controller refuses to start if unset)
# Variable: ADMIN_TOKEN | Alias: CB_ADMIN_TOKEN
ADMIN_TOKEN="iFkg1cP5tzY-NEywZsE5gM_q7rg3PK5kTRIQKm8oVCg"
# Variable: WORKER_SECRET | Alias: CB_WORKER_SECRET
WORKER_SECRET="LI72q7cis9bKoFlLGk9xJwrk2ZHEjOSy0dRHpXVaegs"

# --- 2. Network Endpoints, Ports & Frontend Assets ---
# Variable: WORKER_URLS | Alias: CB_WORKER_URLS
WORKER_URLS="http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003"
# Variable: CONTROLLER_URL | Aliases: CB_CONTROLLER_URL, CB_BASE_URL
CONTROLLER_URL="http://127.0.0.1:8000"
# Variable: CONTROLLER_HOST | Alias: CB_CONTROLLER_HOST
CONTROLLER_HOST="0.0.0.0"
# Variable: CONTROLLER_PORT | Alias: CB_CONTROLLER_PORT
CONTROLLER_PORT="8000"
# Variable: CB_FRONTEND_DIST_DIR | Alias: FRONTEND_DIST_DIR
CB_FRONTEND_DIST_DIR="frontend/dist"

# --- 3. Public Task Security, Rate Limits & Persistence Paths ---
# Variable: CB_API_KEY | Alias: API_KEY (optional when CB_REQUIRE_API_KEY="false"; required with no default when "true")
CB_API_KEY=""
# Variable: CB_REQUIRE_API_KEY | Alias: REQUIRE_API_KEY
CB_REQUIRE_API_KEY="false"
# Variable: CB_ALLOWED_ORIGINS | Alias: ALLOWED_ORIGINS
CB_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:5173"
# Variable: CB_RATE_LIMIT_PER_SEC | Alias: RATE_LIMIT_PER_SEC
CB_RATE_LIMIT_PER_SEC="300"
# Variable: CB_RATE_LIMIT_PER_MIN | Alias: RATE_LIMIT_PER_MIN
CB_RATE_LIMIT_PER_MIN="2400"
# Variable: CB_MAX_PAYLOAD_BYTES | Alias: MAX_PAYLOAD_BYTES
CB_MAX_PAYLOAD_BYTES="65536"
# Variable: CB_DATA_DIR | Alias: DATA_DIR
CB_DATA_DIR="data"

# --- 4. Dual-Mode Persistence ---
# Variable: CB_LOCAL_MODE | Alias: LOCAL_MODE
CB_LOCAL_MODE="true"
# Variable: CB_SEED_DEMO_WORKERS | Alias: SEED_DEMO_WORKERS
CB_SEED_DEMO_WORKERS="true"
# Variable: CB_REDIS_URL | Alias: REDIS_URL
CB_REDIS_URL="redis://:replace-with-redis-password@localhost:6379/0"
# Variable: CB_MONGO_URL | Alias: MONGO_URL
CB_MONGO_URL="mongodb://localhost:27017"
# Variable: CB_MONGO_DB_NAME | Alias: MONGO_DB_NAME
CB_MONGO_DB_NAME="cloudbalance"

# --- 5. Scheduler, Telemetry & Dispatch Controls ---
# Variable: CB_WORKER_TTL_SECONDS | Alias: WORKER_TTL_SECONDS
CB_WORKER_TTL_SECONDS="10"
# Variable: CB_MAX_QUEUE_DEPTH | Alias: MAX_QUEUE_DEPTH
CB_MAX_QUEUE_DEPTH="500"
# Variable: CB_SOLVER_TIME_LIMIT_MS | Alias: SOLVER_TIME_LIMIT_MS
CB_SOLVER_TIME_LIMIT_MS="50"
# Variable: CB_CPU_CAP_PCT | Alias: CPU_CAP_PCT
CB_CPU_CAP_PCT="85.0"
# Variable: CB_MEM_CAP_PCT | Alias: MEM_CAP_PCT
CB_MEM_CAP_PCT="90.0"
# Variable: CB_DISPATCH_TIMEOUT_SEC | Alias: DISPATCH_TIMEOUT_SEC
CB_DISPATCH_TIMEOUT_SEC="15.0"
# Variable: CB_DISPATCH_MAX_RETRIES | Alias: DISPATCH_MAX_RETRIES
CB_DISPATCH_MAX_RETRIES="2"
# Variable: CB_WS_BROADCAST_INTERVAL_SEC | Alias: WS_BROADCAST_INTERVAL_SEC
CB_WS_BROADCAST_INTERVAL_SEC="1.5"
# Variable: CB_DEFAULT_SCHEDULER | Alias: DEFAULT_SCHEDULER
CB_DEFAULT_SCHEDULER="ortools_milp"

# --- 6. Worker Node & Verification Client Settings (WorkerSettings / ClientSettings) ---
# Worker Variables (optional overrides; aliases supported with CB_ prefix):
#   WORKER_ID / CB_WORKER_ID="worker-1"
#   WORKER_IP / CB_WORKER_IP="127.0.0.1"
#   WORKER_PORT / CB_WORKER_PORT="8001"
#   WORKER_URL / CB_WORKER_URL="http://127.0.0.1:8001"
#   WORKER_TOTAL_MEM_MB / CB_WORKER_TOTAL_MEM_MB="4096.0"
#   WORKER_BASE_CPU_PCT / CB_WORKER_BASE_CPU_PCT="8.0"
#   WORKER_BASE_MEM_MB / CB_WORKER_BASE_MEM_MB="420.0"
#   WORKER_TIME_SCALE / CB_WORKER_TIME_SCALE="0.15"
#   WORKER_MAX_PHYSICAL_DIM / CB_WORKER_MAX_PHYSICAL_DIM="350"
#   WORKER_CONCURRENCY_LIMIT / CB_WORKER_CONCURRENCY_LIMIT="2"
#   WORKER_QUEUE_CAPACITY / CB_WORKER_QUEUE_CAPACITY="4"
#   WORKER_TASK_TIMEOUT_SEC / CB_WORKER_TASK_TIMEOUT_SEC="10.0"
#   HEAVY_TASK_ITERATIONS / CB_HEAVY_TASK_ITERATIONS="180000"
#   WORKER_ENABLE_AGENT / CB_WORKER_ENABLE_AGENT="false"
#   WORKER_TELEMETRY_INTERVAL / CB_WORKER_TELEMETRY_INTERVAL="1.5"

# --- 7. Docker Compose & GCP Provisioning Variables (not read by backend Settings) ---
REDIS_PASSWORD="replace-with-redis-password"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
ALLOWED_CIDR="203.0.113.10/32"
