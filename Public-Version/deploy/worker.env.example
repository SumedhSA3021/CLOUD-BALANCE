# CloudBalance Private Worker VM Environment Template (/etc/cloudbalance/worker.env)
# Copy to /etc/cloudbalance/worker.env with chmod 600 on each worker VM (worker-1..3).
# Never place ADMIN_TOKEN or database credentials on Worker VMs.
# Generate WORKER_SECRET (>= 32 chars, matching Controller's WORKER_SECRET) using:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- REQUIRED Shared Telemetry Secret (NO default; must match Controller's WORKER_SECRET) ---
WORKER_SECRET=

# --- Worker Identity & Internal VPC Addressing ---
# Set per worker VM: worker-1, worker-2, worker-3
WORKER_ID="<WORKER_ID>"
# Worker's OWN private VPC IP (internal only; never a public IP):
WORKER_IP="<WORKER_OWN_INTERNAL_IP>"
WORKER_PORT="8001"
# Controller's INTERNAL VPC IP, NEVER the public static external IP:
CONTROLLER_URL="http://<CONTROLLER_INTERNAL_IP>:8000"

# --- Telemetry Agent & Execution Limits ---
# Set "true" only when running inline agent inside executor; systemd uses dedicated worker-agent unit.
WORKER_ENABLE_AGENT="false"
WORKER_TELEMETRY_INTERVAL="1.5"
WORKER_CONCURRENCY_LIMIT="2"
WORKER_QUEUE_CAPACITY="4"
WORKER_TASK_TIMEOUT_SEC="10.0"
MAX_PAYLOAD_BYTES="65536"
HEAVY_TASK_ITERATIONS="180000"

# --- Baseline Host Capacity & Workload Calibration ---
WORKER_TOTAL_MEM_MB="4096.0"
WORKER_BASE_CPU_PCT="8.0"
WORKER_BASE_MEM_MB="420.0"
WORKER_TIME_SCALE="0.15"
WORKER_MAX_PHYSICAL_DIM="350"
