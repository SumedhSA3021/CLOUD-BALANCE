# CloudBalance Controller VM Environment Template (/etc/cloudbalance/controller.env)
# Copy to /etc/cloudbalance/controller.env with chmod 600. Never commit real secrets.
# Generate high-entropy secrets (>= 32 chars) using:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- REQUIRED Secrets (NO defaults; Controller refuses to start if missing/blank) ---
ADMIN_TOKEN=
WORKER_SECRET=

# --- Runtime Mode (Tested Single-Process Configuration) ---
CB_APP_NAME="CloudBalance Controller"
CB_ENV="production"
# Tested configuration: keep CB_LOCAL_MODE="true" and run Controller with ONE process (--workers 1).
# SQLite/in-memory TTL store keeps rr_counter, ActiveTestManager, and in-flight state consistent.
CB_LOCAL_MODE="true"
# Must be "false" on GCP so Controller routes ONLY to real private Worker VMs (never virtual fallback).
CB_SEED_DEMO_WORKERS="false"

# --- Network Binding, Worker VPC Endpoints & Public Origin ---
# Bind host: use 127.0.0.1 behind Nginx on the same VM, or 0.0.0.0 if exposing :8000 directly.
CONTROLLER_HOST="<CONTROLLER_BIND_HOST>"
CONTROLLER_PORT="8000"
# Controller INTERNAL VPC URL (used inside VPC by workers/internal health probes, e.g. 10.128.0.10):
CONTROLLER_URL="http://<CONTROLLER_INTERNAL_IP>:8000"
# Worker PRIVATE VPC URLs ONLY (internal IPs; NEVER reuse external IPs):
WORKER_URLS="http://<WORKER_1_INTERNAL_IP>:8001,http://<WORKER_2_INTERNAL_IP>:8001,http://<WORKER_3_INTERNAL_IP>:8001"
# Controller STATIC EXTERNAL IP (or HTTPS domain) used by public browsers and /client traffic:
CB_ALLOWED_ORIGINS="http://<CONTROLLER_STATIC_EXTERNAL_IP>,https://<CONTROLLER_DOMAIN_OPTIONAL>"
CB_FRONTEND_DIST_DIR="frontend/dist"

# --- Data Persistence Directory (Ensure writable by service user ubuntu) ---
CB_DATA_DIR="/var/lib/cloudbalance/data"

# --- Optional API Key Gate for /api/v1/tasks (leave CB_REQUIRE_API_KEY="false" unless enabled) ---
CB_REQUIRE_API_KEY="false"
CB_API_KEY=

# --- Limits, Scheduler & Telemetry Controls ---
CB_DEFAULT_SCHEDULER="ortools_milp"
CB_WORKER_TTL_SECONDS="10"
CB_MAX_QUEUE_DEPTH="500"
CB_RATE_LIMIT_PER_SEC="300"
CB_RATE_LIMIT_PER_MIN="2400"
CB_MAX_PAYLOAD_BYTES="65536"
CB_SOLVER_TIME_LIMIT_MS="50"
CB_CPU_CAP_PCT="85.0"
CB_MEM_CAP_PCT="90.0"
CB_DISPATCH_TIMEOUT_SEC="15.0"
CB_DISPATCH_MAX_RETRIES="2"
CB_WS_BROADCAST_INTERVAL_SEC="1.5"

# --- Optional External Redis / MongoDB (UNVERIFIED end-to-end; requires CB_LOCAL_MODE="false") ---
# Leave commented unless deploying and verifying external Redis + MongoDB on the Controller VM.
# CB_REDIS_URL="redis://:<REDIS_PASSWORD>@<REDIS_INTERNAL_OR_LOCAL_HOST>:6379/0"
# CB_MONGO_URL="mongodb://<MONGO_INTERNAL_OR_LOCAL_HOST>:27017"
# CB_MONGO_DB_NAME="cloudbalance"
