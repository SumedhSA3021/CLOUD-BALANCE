[Unit]
Description=CloudBalance Internal Worker NumPy Executor (:8001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<APP_DIR>
EnvironmentFile=/etc/cloudbalance/worker.env
ExecStart=<VENV_DIR>/bin/uvicorn worker.executor:app --host 0.0.0.0 --port 8001 --workers 1
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
