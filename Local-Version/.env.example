# CloudBalance 12-Factor Environment Configuration Example
# Copy to .env and customize for your deployment. Never commit production secrets!

CB_APP_NAME="CloudBalance Controller"
CB_ENV="development"

# Security & CORS
CB_API_KEY="replace-with-strong-random-api-key"
CB_REQUIRE_API_KEY="false"
CB_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173"

# Dual-Mode Persistence (set CB_LOCAL_MODE=true for zero-dependency in-memory TTL + SQLite mode)
CB_LOCAL_MODE="true"
CB_SEED_DEMO_WORKERS="true"
REDIS_PASSWORD="replace-with-redis-password"
CB_REDIS_URL="redis://:replace-with-redis-password@localhost:6379/0"
CB_MONGO_URL="mongodb://localhost:27017"
CB_MONGO_DB_NAME="cloudbalance"

# Micro-Batcher & MILP Solver Tuning
CB_WORKER_TTL_SECONDS="10"
CB_MAX_QUEUE_DEPTH="500"
CB_RATE_LIMIT_PER_SEC="300"
CB_BATCH_WINDOW_MS="200"
CB_BATCH_MAX_SIZE="20"
CB_SOLVER_TIME_LIMIT_MS="50"
CB_CPU_CAP_PCT="85.0"
CB_MEM_CAP_PCT="90.0"
CB_DISPATCH_TIMEOUT_SEC="12.0"
CB_DISPATCH_MAX_RETRIES="2"
CB_WS_BROADCAST_INTERVAL_SEC="1.5"
CB_DEFAULT_SCHEDULER="ortools_milp"

# GCP Provisioning Variables (used by infra/gcp/provision.sh)
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
ALLOWED_CIDR="203.0.113.10/32"

